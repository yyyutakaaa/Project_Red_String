# Only what the web build needs goes to Vercel. Local secrets and tooling stay on this machine.
.git
.claude
.vercel
node_modules
**/node_modules
.env
*.local
**/.env.local
tools
web/dist
web/test-results
web/playwright-report
supabase/.temp
supabase/.branches
supabase/seed
# The desktop shell's own files stay: the web build fingerprints them (see web/vite.config.ts).
/desktop/node_modules
/desktop/release
/desktop/renderer
/desktop/build
